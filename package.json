{
  "name": "hydrorage",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "yarn workspace @hydrorage/api start:dev",
    "api:build": "yarn workspace @hydrorage/api build",
    "mobile": "yarn workspace @hydrorage/mobile start",
    "mobile:android": "yarn workspace @hydrorage/mobile android",
    "mobile:ios": "yarn workspace @hydrorage/mobile ios",
    "web": "yarn workspace @hydrorage/web dev",
    "web:build": "yarn workspace @hydrorage/web build",
    "admin": "yarn workspace @hydrorage/admin dev",
    "admin:build": "yarn workspace @hydrorage/admin build",
    "db:migrate": "yarn workspace @hydrorage/api db:migrate",
    "db:seed": "yarn workspace @hydrorage/api db:seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env up -d"
  },
  "engines": {
    "node": "26.10.0",
    "yarn": "4.18.1"
  },
  "resolutions": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  },
  "volta": {
    "node": "26.10.0",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1"
}
