# Copy to /opt/hydrorage/.env on the VPS (never commit real secrets).

IMAGE_TAG=local

# Shared VPS: loopback is fine for host curls; TTEN nginx reaches us via Docker network
# (install-into-edge-nginx.sh connects hydrorage-nginx to ttengamesstudio network).
HTTP_BIND=127.0.0.1:9080

POSTGRES_USER=hydrorage
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hydrorage

# Must match docker/pgbouncer/pgbouncer.ini + userlist.txt
DATABASE_URL=postgresql://hydrorage:change-me-strong-password@pgbouncer:5432/hydrorage
DIRECT_URL=postgresql://hydrorage:change-me-strong-password@postgres:5432/hydrorage
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change-me-access-long-random
JWT_REFRESH_SECRET=change-me-refresh-long-random
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PORT=3000

GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.hydrorage.com.tr/api/auth/google/callback
ADMIN_APP_URL=https://admin.hydrorage.com.tr
LANDING_URL=https://hydrorage.com.tr
ADMIN_EMAILS=you@example.com
APPLE_CLIENT_ID=com.hydrorage.app
# Opsiyonel. Boşsa Edge TTS kullanılır.
GOOGLE_TTS_API_KEY=

# AdMob — API bunu kullanmaz. Expo/EAS derlemesi okur (EXPO_PUBLIC_*).
# Boş bırakılırsa mağaza sürümünde reklam çıkmaz. AdMob konsolundaki gerçek kimlikleri yaz.
# Yerel test kimlikleri: apps/mobile/.env.example
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_APP_OPEN=
EXPO_PUBLIC_ADMOB_IOS_APP_OPEN=

# Vite bake-in (docker build args)
VITE_API_URL=https://api.hydrorage.com.tr/api
VITE_ADMIN_URL=https://admin.hydrorage.com.tr
VITE_LANDING_URL=https://hydrorage.com.tr
VITE_PLAUSIBLE_DOMAIN=hydrorage.com.tr
